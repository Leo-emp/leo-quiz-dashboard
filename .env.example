# ============================================================
# Leo Quiz Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ── REQUIRED: Admin Authentication ──────────────────────────
# Email and password for the single-admin login page.
# These are checked server-side on every login attempt.
ADMIN_EMAIL=admin@leoquiz.com
ADMIN_PASSWORD=

# Session encryption key — must be at least 32 characters.
# Used by iron-session to encrypt the auth cookie.
# Generate one: openssl rand -hex 32
SESSION_SECRET=

# ── REQUIRED: Database (Turso) ──────────────────────────────
# Turso embedded SQLite database — stores all video records,
# activity logs, schedule config, and analytics.
# Get from: https://turso.tech → create database → copy URL + token
TURSO_DATABASE_URL=              # e.g. libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=                # Auth token from Turso dashboard

# ── REQUIRED: Storage (Vercel Blob) ─────────────────────────
# Stores rendered videos, thumbnails, and OAuth tokens.
# Get from: Vercel dashboard → Storage → Blob → create store → copy token
BLOB_READ_WRITE_TOKEN=

# ── REQUIRED: GitHub Actions Integration ────────────────────
# Triggers pipeline workflows and polls run status.
# Token needs "repo" and "workflow" scopes.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO_OWNER=Leo-emp       # GitHub username or org
GITHUB_REPO_NAME=leo-quiz-pipeline  # Pipeline repo name (not dashboard)

# ── REQUIRED: Webhook Security ──────────────────────────────
# Shared secret between the pipeline GitHub Action and this dashboard.
# The pipeline sends this in x-webhook-secret header when reporting completion.
# Must match the DASHBOARD_WEBHOOK_SECRET in the pipeline's GitHub secrets.
# Generate one: openssl rand -hex 32
DASHBOARD_WEBHOOK_SECRET=

# ── REQUIRED: Cron Security ─────────────────────────────────
# Vercel Cron authorization secret — protects /api/cron/* endpoints.
# Set in Vercel dashboard → Settings → Environment Variables.
# Vercel automatically sends this header on cron invocations.
CRON_SECRET=

# ── REQUIRED: App URL ───────────────────────────────────────
# Public-facing URL of this dashboard. Used for OAuth redirect URIs
# and internal API calls (analytics refresh, cron endpoints).
# In development: http://localhost:3000
# In production: https://your-dashboard.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── OPTIONAL: YouTube OAuth (connect-once) ──────────────────
# Enables one-click YouTube uploading from the dashboard.
# Create OAuth 2.0 credentials at: https://console.cloud.google.com
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── OPTIONAL: TikTok OAuth (connect-once) ───────────────────
# Enables one-click TikTok uploading from the dashboard.
# Create app at: https://developers.tiktok.com
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── OPTIONAL: Meta/Instagram/Facebook OAuth ─────────────────
# Enables posting to Instagram Reels and Facebook from the dashboard.
# Create app at: https://developers.facebook.com
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/meta/callback
META_APP_ID=
META_APP_SECRET=

# ── OPTIONAL: Admin Alerts ──────────────────────────────────
# Webhook URL for sending admin notifications (e.g. Slack or Discord).
# Called by notify-admin.ts when videos fail or need attention.
# Slack: create incoming webhook at https://api.slack.com/messaging/webhooks
# Discord: Server Settings → Integrations → Webhooks → copy URL + /slack suffix
ALERT_WEBHOOK_URL=
